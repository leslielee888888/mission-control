# Copy to .env on the NAS and adjust if needed - not committed (git-ignored).

# Which published image tag each service runs. The web image is tagged
# separately from the API because VITE_API_BASE_URL is baked into its
# static JS bundle at build time - it's specific to this deployment's
# network, not interchangeable with the :latest build used for local dev.
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=nas

# Host ports on the NAS.
API_PORT=8100
WEB_PORT=8101
